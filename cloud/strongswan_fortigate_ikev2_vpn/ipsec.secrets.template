# Copy to /etc/ipsec.secrets (chmod 600, owner root:root) and fill in the
# real values. NEVER put these values on a command line or in shell history.
# strongSwan reads this file directly.

# The gateway's pre-shared key (matches rightauth=psk in ipsec.conf)
: PSK "REPLACE_WITH_PRESHARED_KEY"

# EAP user name and password (matches leftauth=eap-mschapv2).
# The identity must match eap_identity in ipsec.conf.
REPLACE_WITH_EAP_USERNAME : EAP "REPLACE_WITH_EAP_PASSWORD"
